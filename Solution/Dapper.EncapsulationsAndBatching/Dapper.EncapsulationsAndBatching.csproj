
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>8.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Nullable>Enable</Nullable>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<UseShortFileNames>True</UseShortFileNames>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Dapper.EncapsulationsAndBatching</AssemblyName>
		<RootNamespace>Dapper.EncapsulationsAndBatching</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<Title>Dapper.EncapsulationsAndBatching</Title>
		<Authors>Daniel Marín</Authors>
		<Description>A set of types for encapsulating database operations and a way to execute them batched in a single round trip.</Description>
		<Version>1.1.1-beta</Version>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/marin-8/Dapper.EncapsulationsAndBatching</RepositoryUrl>
		<PackageTags>dapper;orm;micro-orm;sql;batch</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.35" />
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

</Project>
